/* [wxMaxima: input   start ] */
g(x,y):=2*(x*y+1)/sqrt((1-y)*(1-(2*x+1)^2*y))-1;
A283614(n,k):=coeff(limit(diff(g(x,y),y,n)/n!,y,0),x,k);
A283615(n,k):=block([s,d],
s:0,
for d in divisors(gcd(n,k)) do
s:s+totient(d)*A283614(n/d,k/d),
return(s/(2*n+k)));
