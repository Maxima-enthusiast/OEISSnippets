/* [wxMaxima: input   start ] */
g(n):= if n=0 then 1 else if oddp(n)=true  then n else 0;
P(m,n):=if n=m then g(n) else sum(g(k)*P(k,n-k),k,m,n/2)+g(n);
a(n):=P(1,n);
makelist(a(n),n,0,27); /* Vladimir Kruchinin, Sep 06 2014 */
