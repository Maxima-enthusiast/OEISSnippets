/* [wxMaxima: input   start ] */
(f(i, j):=mod((i-floor((i-j)/j)), j),
(n:3, for t:7 thru 100000 step 4 do
(for k:3 while f(t, k)#1 and k<ceiling(t/2) do
(if k=ceiling(t/2)-1 then (print(n, "", t), n:n+1)))));
