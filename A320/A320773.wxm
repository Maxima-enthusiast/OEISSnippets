/* [wxMaxima: input   start ] */
block([n: 2, m: 0, r: 0, k: 0, kmax: 10,v: ""],
while k<kmax do
(m: floor(sqrt(n)), r: n-m^2,
if mod(2*m,r)=0 then (k: k+1, print(n)),
if r= m then n: n+m else (if r= 2*m then n: n+2 else n: n+1)));
