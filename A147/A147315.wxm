Co(n,k):=sum(binomial(k,j)*(if oddp(n-k+j) then 0 else if (n-k+j)/2<j then 0 else j*2^(-n+k+1)*binomial(n-k-1,(n-k+j)/2-1)/(n-k+j))*(-1)^j,j,1,k)+kron_delta(n,k);
A147315(n,m):=1/m!*sum((if oddp(n-k) then 0 else 2^(1-k)*sum((-1)^(floor((n+k)/2)-i)*binomial(k,i)*(2*i-k)^n,i,0,floor(k/2)))*(sum(Co(i,m)*binomial(k-i+m-1,m-1),i,1,k)),k,m,n); /* _Vladimir Kruchinin_, Feb 17 2011 */
T(n,m):=(sum(binomial(k+m,m)*((-1)^(n-k-m)+1)*sum(binomial(j+k+m,k+m)*(j+k+m+1)!*2^(-j-k-1)*(-1)^((n+k+m)/2+j+k+m)*stirling2(n+1,j+k+m+1), j,0,n-k-m), k,0,n-m))/(m+1)!; /* _Vladimir Kruchinin_, May 17 2011 */
