/* [wxMaxima: input   start ] */
p(x, n) := if mod(n, 2) = 0 then (x + 1)*p(x, n - 1) else (x^3 + x^2 + x + 1)^floor(n/2)$
T(n, k) := ratcoef(p(x, n), x, k)$
create_list(T(n, k), n, 1, 12, k, 0, hipow(fullratsimp(p(x, n)), x));
