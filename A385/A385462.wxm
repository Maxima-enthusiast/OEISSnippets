/* [wxMaxima: input   start ] */
(n:1, for t:1 thru 10000 do (s:divsum(t), (A:args(divisors(t)),
for i:1 thru length(A)-1 do (y:s+A[i],
if mod(y,t)=0 then (print(n,"",t), n:n+1)))));
