T(n,m):=if n=m then 1 else 1/2*(2^(n-m)*sum(binomial(j,n-3*m+2*j)*binomial(m,j),j,0,m)-sum(T(n,k)*T(k,m),k,m+1,n-1));
makelist((T(n,1)),n,1,10);

