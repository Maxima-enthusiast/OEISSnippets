T(n, m):=if n=m then 1 else 1/3*(3^(n-m)*sum(binomial(j,n-3*m+2*j)*binomial(m,j),j,0,m)-sum(T(k, m)*sum(T(n, i)*T(i, k), i, k, n), k, m+1, n-1)-sum(T(n, i)*T(i, m), i, m+1, n-1));
makelist(T(n,1),n,1,7);

