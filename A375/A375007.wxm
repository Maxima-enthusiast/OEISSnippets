/* [wxMaxima: input   start ] */
(f(i,j):=mod((i-floor((i-j)/j)),j),
(n:4, for t:4 thru 100000 step 4 do
(for k:2 while f(t,k)#0 and k<t/2+1 do
(if k=t/2 then (print(n, "", t), n:n+1)))));
