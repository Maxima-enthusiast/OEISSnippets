/* [wxMaxima: input   start ] */
/* Find triangle */
Co(n,k):=if k=1  then a(n) else sum(a(i+1)*Co(n-i-1,k-1),i,0,n-k);
a(n):=if n=1 then 1 else 1/n*sum(Co(n-1,k)*x(k),k,1,n-1);
makelist(ratsimp(n!*a(n)),n,1,5);
