/* [wxMaxima: input   start ] */
T(n,k):= if ( n<k or k<0 ) then 0 else if ( k<=1 or k=n ) then 1 else sum(T(n-k,j)*T(k,k-j),j,0, k);
makelist(sum(T(n,k),k,0,n),n,0,12); /* _Emanuele Munarini_, May 12 2012 */
