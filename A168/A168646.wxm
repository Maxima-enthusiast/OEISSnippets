T(n,k) := if k = 0 or k = n then 1 else (if n <= 6 then (8 - n)*binomial(n, k) else ratcoef(6*(x + 1)^n - sum(sum(binomial(n, j)*(x^j + x^(n - j)), j, 1, i), i, 1, 4), x, k))$
create_list(T(n, k), n, 0, 12, k, 0, n); /* _Franck Maminirina Ramaharo_, Jan 02 2019 */
