a[n]:=if n<2 then 2*n+1 else (n+1)*(n+2)/2+(n-1)*a[n-1]+sum((-a[k]+(k+1)*(k+2)/2)*a[n-k]+(k+1)*(k+2)*(n-1-k)*a[n-1-k]/2,k,1,n-1);
makelist(a[n],n,0,100); /* _Tani Akinari_, Nov 29 2017 */
