a(n):=sum(sum(binomial(k,r)*sum(sum(binomial(l,j)/2^(j-1)*sum((-1)^(n)*binomial(j,i)*(j-2*i)^(2*n),i,0,floor((j-1)/2))*(-1)^(l-j),j,1,l)*(-1)^l*binomial(r+l-1,r-1),l,1,2*n)*(-1)^(1-r),r,1,k)/k,k,1,2*n); /* _Vladimir Kruchinin_, Aug 23 2010 */
a[n]:=if n=1 then 1 else 2*sum(sum(binomial(2*j,j+k)*(-4*k^2)^(n-1)*(-1)^k/(4^j),k,1,j),j,1,n-1);
makelist(a[n],n,1,30); /* _Tani Akinari_, Sep 20 2023 */
