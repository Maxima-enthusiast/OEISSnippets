Co(n,k,a):= if k=1 then a(n) else sum(a(i+1)*Co(n-i-1,k-1,a), i,0,n-k); a(n):= if n=1 then 1 else (1/n)*sum(Co(n-1,k,a)*a(k),k,1,n-1); makelist(n!*a(n),n,1,7); /* Vladimir Kruchinin, Jun 30 2011 */
