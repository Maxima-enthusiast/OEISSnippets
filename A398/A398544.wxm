/* [wxMaxima: input   start ] */
block(kmax:10^17, prim[1]:2, j:1, primax : log(kmax) / log(2), sum:[54],
while prim[j]<primax do (prim[j+1]:next_prime(prim[j]), j:j+1), jmax:j-1,
for j1 from 1 thru jmax do (p : prim[j1], j2 : j1, su : 0,
while su < kmax do (j2 : j2 + 1, q : prim[j2], su : p ^ q + q ^ p,
if su < kmax then if mod(su,3)=0 then sum: append(sum,[su]))),
sum:sort(sum));
