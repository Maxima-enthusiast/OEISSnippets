a(n):=sum(sum(stirling1(n,r+m)*sum(binomial(k+m-1,m-1)*(k+m)!*(-1)^(k)*2^(r-k)*stirling2(r+m,k+m),k,0,r),r,0,n-m)/m!,m,1,n); /* _Vladimir Kruchinin_, Jun 06 2011 */
a[n]:=if n<4 then (n+1)*(2-n)/2 else (3-2*n)*a[n-1]+(n-1)*(5-2*n)*a[n-2]+(1-n)*(n-2)*(n-3)*a[n-3]+(1-n)*(n-2)*(n-3)*(n-4)*a[n-4]/4;
makelist(a[n],n,0,50); /* _Tani Akinari_, Feb 21 2024 */
a(n):=sum(sum(binomial(-k,j)*binomial(k+j,n-k-j)*(n!/k!)*2^(k+j-n),j,0,n-k),k,0,n); /* _Tani Akinari_, Feb 21 2024 */
