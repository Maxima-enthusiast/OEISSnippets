T(n,k):= if n<3*k then 0 else if n/3=k then 1 else sum(binomial(3*k,j)*sum(T(i,3*k-j)*T(n-j,i), i,3*k-j+1,n-j-1), j,0,3*k-1);
makelist(T(n,1),n,1,20); /* Vladimir Kruchinin, May 17 2012 */
