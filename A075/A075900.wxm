/* [wxMaxima: input   start ] */
s(m,n):=if n<m then 0 else if n=m then 2^(n-1) else sum(2^(k-1)*s(k,n-k),k,m,ceiling(n/2))+2^(n-1);
makelist(s(1,n),n,1,27); /* Vladimir Kruchinin, Sep 06 2014 */
