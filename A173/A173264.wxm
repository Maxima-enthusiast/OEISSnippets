/* [wxMaxima: input   start ] */
(kk : 50, nn : 15)$
gf(n) := taylor(if n = 0 then 1/(1 - x) else ((x - 2)*x^n + 1)/((x - 1)*(x + 1)^n), x, 0, kk)$
T(n, k) := ratcoef(gf(n), x, k)$
create_list(T(k, n - k), n, 0, nn, k, 0, n);
