/* [wxMaxima: input   start ] */
for n:0 thru 20 do
(Ms:matrix(
[binomial(2*n, n), binomial(2*n+1, n), binomial(2*n+2, n), binomial(2*n+3,n)],
[binomial(2*n+1, n+1), binomial(2*n+2, n+1), binomial(2*n+3, n+1), binomial(2*n+4,n+1)],
[binomial(2*n+2, n+2), binomial(2*n+3, n+2), binomial(2*n+4, n+2), binomial(2*n+5,n+2)],
[binomial(2*n+3, n+3), binomial(2*n+4, n+3), binomial(2*n+5, n+3), binomial(2*n+6,n+3)]),
print(determinant(Ms))); /* Vladimir Kruchinin, Sep 13 2025 */
