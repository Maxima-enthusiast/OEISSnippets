G(n,k):=(if n=k then 1 else if k=1 then (-sum(binomial(n-1,k-1)*G(n,k),k,2,n)) else sum(G(i+1,1)*G(n-i-1,k-1),i,0,n-k));
makelist(G(n,1),n,1,10); /* Vladimir Kruchinin, Mar 07 2014 */
