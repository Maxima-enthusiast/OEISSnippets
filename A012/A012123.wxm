a(n):=sum(sum((sum((-1)^((3*k)/2)*(sum((2^i*stirling1(m+i,m)* binomial(m+k-1,m+i-1))/(m+i)!,i,0,k))*binomial((r-2)/2,(r-m-k)/2),k,0,r-m))*((-1)^(r-m)+1)*sum(binomial(k-1,r-1)*k!*2^(n-k)*stirling2(n,k)*(-1)^(r+k),k,r,n),r,m,n),m,1,n)/2; /* _Vladimir Kruchinin_, Jun 09 2011 */

