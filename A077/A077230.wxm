a(n):=if n=0 then 2 else num(sum(4^(-k)*binomial(2*k,k)*sum((j!*binomial(k,j)*(-1)^(j)*stirling1(n+j,j))/(n+j)!,j,1,k),k,1,n)); /* _Vladimir Kruchinin_, Feb 18 2015 */
