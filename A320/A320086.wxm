T(n, k) := 2^(n - 1)/gcd(n*(binomial(n - 1, k - 1) - binomial(n - 1, k)), 2^(n - 1))$
tabl(nn) := for n:0 thru nn do print(makelist(T(n, k), k, 0, n))$
