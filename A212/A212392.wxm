A(n,k):= if  n<2*k then 0 else if n/2=k then 1 else sum(binomial(2*k,j)*sum(A(i,2*k-j)*A(n-j,i),i,2*k-j+1,n-j-1),j,0,2*k-1);
makelist(A(n,1),n,1,17); /* _Vladimir Kruchinin_, May 15 2012 */

