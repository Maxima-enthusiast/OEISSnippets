a(n):=if n<3 then 1/n! else (a(n-2)*(n-2)+sum(a(i+3)*(i+1)*(i+2)*(i+3)*a(n-3-i),i,0,n-4))/(n*(n-1)*(n-2));
makelist(n!*a(n),n,1,17); /* Vladimir Kruchinin, Nov 18 2011 */
