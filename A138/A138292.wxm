T(n,m):=if n=m then 1 else (1+(-1)^(n-m))/2*((n-m)/2)!*sum(m^k*T((n-m)/2,k)/(k!*((n-m-2*k)/4)!),k,1,(n-m)/2);
makelist(T(2*n-1,1),n,1,20); /* _Vladimir Kruchinin_, Mar 18 2015 */

