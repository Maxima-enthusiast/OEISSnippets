/* [wxMaxima: input   start ] */
(nn : 15, kk : 50)$
gf(n) := taylor(if n = 1 then 1/(1 - x) else  1/(-1 + x - x^n), x, 0, kk)$
T(n, k) := ratcoef(gf(n), x, k)$
create_list(T(n - k, k), n, 1, nn, k, 0, n - 1);
