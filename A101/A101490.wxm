T(n,k):= if n<0  then 0 else if n=k then 1 else if n>0 and k=0 then 0 else T(n-1,k)-T(n-2,k)+T(n-1,k-1)+2*T(n-3,k-1)+T(n-5,k-1);
makelist(T(2*n-1,n)/n,n,1,7); /* Vladimir Kruchinin, Sep 29 2014 */
