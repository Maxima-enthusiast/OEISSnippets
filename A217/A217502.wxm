a(n):=if n=0 then 1 else sum((sum(binomial(k-1,m-1)*sum(binomial(j-1,2*k-1)*(j)!*2^(m-j)*(-1)^(n+k+j)*stirling2(2*n,j),j,2*k,2*n),k,m,2*n))/m!,m,1,2*n);

