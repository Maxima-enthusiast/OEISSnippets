egypt(x) := block([i,n,d,p,e, on, od], ( n : num(x), d : n/x, on : n, od : d, p : 0, e : [], for i:1 while x>0 do ( n : num(x), d : n/x, p : fix((d+n-1)/n), x : x - 1/p, e : append(e, [p]) ), return(p) ) ); for b:2 step 1 thru 100 do ( max:2, for a:2 step 1 thru b-1 do ( if gcd(a,b)=1 then ( m : egypt(a/b), if m>max then max : m ) ), print("a[", b, "]=", max) ), t$
