B(n):=(if n=1 then 1/(1+x)*exp(-x) else -n!*sum((sum((-1)^(m-j)*binomial(m,j)*sum((j^(n-i)*binomial(j,i)*x^(m-i))/(n-i)!,i,0,n),j,1,m))*B(m)/m!,m,1,n-1)/(1+x)^n);
a(n):=B(n)*(1+x)^(2*n-1);
