Co(n, k, F):=if k=1 then F(n) else sum(F(i+1)*Co(n-i-1, k-1, F), i, 0, n-k); a(n):=if n=1 then 1 else sum(if 2*k>n then 0 else Co(n, 2*k, a)*a(k), k, 1, n); makelist(a(n), n, 1, 10); /*_Vladimir Kruchinin_, Aug 02 2011 */
T(n,m):=if n=m then 1 else kron_delta(n,m)+sum(binomial(m,j)*sum(if 2*k<=n-j then T(n-j,2*k)*T(k,m-j) else 0,k,m-j,n-j),j,0,m-1); makelist(T(n,1),n,1,12); /* _Vladimir Kruchinin_, May 02 2012 */
