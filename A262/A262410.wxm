/* [wxMaxima: input   start ] */
b(n):=sum((binomial(n-1,n-k)*binomial(2*k+n,k))/(n+k+1),k,0,n);
B(x):=sum(b(n)*x^n,n,0,30);
taylor(diff(B(x),x,1)/B(x)-x*(diff(B(x),x,1))-B(x),x,0,10);
