/* [wxMaxima: input   start ] */
a(n):=sum(binomial(n,k)*binomial(n+k-2,n-k-1),k,0,n-1)/n;
A(x):=sum(a(n)*x^n,n,1,30);
taylor(diff(A(x),x)/A(x)*x,x,0,10);
