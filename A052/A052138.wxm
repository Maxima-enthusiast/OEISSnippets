T(n,m):=if n=m then 1 else 1/3*(stirling1(n,m)*m!/n!-sum(T(k,m)*sum(T(n,i)*T(i,k),i,k,n),k,m+1,n-1)-T(m,m)*sum(T(n,i)*T(i,m),i,m+1,n-1));
makelist(num(T(n,1)),n,1,7); /* _Vladimir Kruchinin_, Mar 10 2012 */

