/* [wxMaxima: input   start ] */
ffib(n):=prod(fib(k),k,1,n);
fibonomial(n,k):=ffib(n)/(ffib(k)*ffib(n-k));
makelist(sum(fibonomial(n,k),k,0,n),n,0,30); /* _Emanuele Munarini_, Apr 02 2012 */
