T(n, k) := if mod(n, 2) = 1 then binomial(n, k) - n*binomial((n - 1)/2, k - 1) else binomial(n, k) - (n/2)*(binomial(n/2, k - 1) + binomial((n - 2)/2, k - 1))$
create_list(T(n, k), n, 3, 20, k, 3, n);

