/* [wxMaxima: input   start ] */
block(u:[],
for m from 0 thru 11 do
for k from floor((m+1)/2) thru 0 step -1 do
if m=0 or k<m then
(x : 2 ^ m - 2 ^ k + 1, u:append(u,[x])), u);
