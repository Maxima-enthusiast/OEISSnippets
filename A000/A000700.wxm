S(n,m):=if n=0 then 1 else if n<m then 0 else if n=m then (-1)^(n+1) else sum((-1)^(k+1)*S(n-k,k),k,m,n/2)+(-1)^(n+1);
makelist(S(n,1),n,0,27); /* Vladimir Kruchinin, Sep 07 2014 */
