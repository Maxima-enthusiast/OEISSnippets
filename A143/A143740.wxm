/* [wxMaxima: input   start ] */
a[n]:=(if n<2 then 1 else a[n-1]+sum((n-1)*(n-k)*binomial(n-2,k)*a[k]*a[n-2-k],k,0,n-2)/2);
makelist(a[n],n,0,100); /* Tani Akinari, Nov 01 2017 */
