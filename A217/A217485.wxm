/* [wxMaxima: input   start ] */
t(n):=sum(stirling2(n,k)*k!,k,0,n);
c(n):=sum(binomial(n,k)*2^k*t(k),k,0,n);
makelist(sum(c(k)*c(n-k),k,0,n),n,0,40);
