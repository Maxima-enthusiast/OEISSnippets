S(n,m):=if n=0 then 1 else if n<m then 0 else if n=m then n+1 else sum((k+1)*S(n-k,k),k,m,n/2)+(n+1);
makelist(S(n,1),n,0,17); /* _Vladimir Kruchinin_, Sep 07 2014 */
